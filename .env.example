# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Bot token: Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID: Discord Developer Portal -> your app -> General Information
CLIENT_ID=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Register slash commands to a single server. Commands appear instantly, which
# is ideal while developing. Leave empty to register globally (up to 1 hour).
GUILD_ID=

# Spotify credentials (https://developer.spotify.com/dashboard). Spotify links
# work without these, but adding them raises the API rate limits.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Prefix for classic text commands, e.g. "!play daft punk".
# Using a prefix requires the MESSAGE CONTENT INTENT to be enabled in the
# Developer Portal (your app -> Bot -> Privileged Gateway Intents).
# Set this to nothing (PREFIX=) to use slash commands only, which needs no
# privileged intent at all.
PREFIX=.

# Starting volume for a new queue, in percent.
DEFAULT_VOLUME=50

# Seconds to wait before leaving an empty voice channel. Set to 0 to stay.
LEAVE_ON_EMPTY_COOLDOWN=60

# Seconds to wait after the queue finishes before leaving. Set to 0 to stay.
LEAVE_ON_FINISH_COOLDOWN=60

# Most tracks taken from a single playlist link.
MAX_PLAYLIST_SIZE=100

# Accent colour for embeds, as a hex code.
EMBED_COLOR=#5865F2

# ---------------------------------------------------------------------------
# yt-dlp — only needed when hosting
# ---------------------------------------------------------------------------

# YouTube answers requests from datacenter IPs (Railway, Fly, most VPS hosts)
# with "Sign in to confirm you're not a bot". Searching still works; fetching a
# stream URL does not. Nothing below is needed when running from home.
#
# Try these in order.

# 1. A different player client. Free, no account, but which clients pass the
#    check changes over time — check the yt-dlp issue tracker for current
#    values before assuming this one still works.
YTDLP_EXTRACTOR_ARGS=

# 2. Cookies from a signed-in session. Use a THROWAWAY Google account: these
#    grant access to it. Export with a "Netscape HTTP Cookie File" browser
#    extension, from a private window you leave open (logging out invalidates
#    them). Expect to refresh every few weeks.
#
#    YTDLP_COOKIES is a path to the file. On a host with no filesystem to
#    upload to, paste the file's contents into YTDLP_COOKIES_CONTENT instead
#    and the bot writes it out at startup.
YTDLP_COOKIES=
YTDLP_COOKIES_CONTENT=

# 3. A proxy, so requests do not come from the host's IP at all. The only
#    reliable fix when the IP itself is the problem, and the only one that
#    costs money — a datacenter proxy is usually blocked too, so this means a
#    residential one.
YTDLP_PROXY=

# Pin a yt-dlp release for scripts/setup-ytdlp.js, e.g. 2025.08.19. Defaults to
# the latest release. YTDLP_PATH points at your own binary and skips the
# download entirely.
YTDLP_VERSION=
YTDLP_PATH=

# Log ffmpeg's command line and stderr. Useful when a track starts and ends
# immediately; noisy otherwise, and it prints signed stream URLs.
DEBUG_FFMPEG=
